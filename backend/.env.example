# Günübirlik İş Bulma Platformu - Environment Variables

# VERİTABANI
DATABASE_URL=file:./dev.db

# JWT SECRET
JWT_SECRET=your-super-secret-jwt-key-change-this

# RESEND (E-posta)
RESEND_API_KEY=
EMAIL_FROM=Günübirlik İş Bul <onboarding@resend.dev>
EMAIL_DEV_MODE=true

# GOOGLE OAUTH
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# CLOUDINARY
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FILE_UPLOAD_MODE=local
